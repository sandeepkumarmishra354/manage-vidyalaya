# The schema-owning role, used only by migrations (node-pg-migrate) and the
# two deliberate tenant-less escape hatches (DbService.queryUnscoped for
# login-by-email, and scripts/seed.ts) -- see migrations/*_enable-row-level-
# security.sql and *_force-row-level-security.sql for why those need it and
# how they stay safe under FORCE ROW LEVEL SECURITY.
DATABASE_URL="postgresql://vidyalaya:vidyalaya@localhost:5432/vidyalaya?schema=public"
# What the running app actually connects as (DbService, see src/db/):
# the restricted `vidyalaya_app` role, which Row-Level Security enforces.
APP_DATABASE_URL="postgresql://vidyalaya_app:vidyalaya_app_dev_only_change_me@localhost:5432/vidyalaya?schema=public"
JWT_SECRET="dev-only-change-me"
JWT_ACCESS_TOKEN_TTL="1h"
JWT_REFRESH_TOKEN_TTL="30d"
PORT=3001
# The API's own public origin -- LocalStorageDriver uses this to build the
# presigned upload/download URLs returned to the browser for documents/
# receipts/photos (see src/storage/local-storage.driver.ts). Left unset it
# defaults to http://localhost:PORT, fine for local dev but unreachable
# from a real browser in production.
# PUBLIC_API_BASE_URL="https://managevidya.in"
# Comma-separated list of allowed browser origins for CORS. Each entry is
# either an exact origin or a single-level subdomain wildcard, e.g.:
#   CORS_ALLOWED_ORIGINS="https://app.yourdomain.tld,https://*.yourdomain.tld"
# ("*.yourdomain.tld" matches "https://greenwood.yourdomain.tld" but not
# "https://foo.bar.yourdomain.tld"). Leave unset for local dev -- falls back
# to allowing every origin (see src/common/cors.ts). Must be set once real
# school subdomains are live browser origins hitting this API.
# Production value for managevidya.in -- covers the bare apex (marketing/
# login-landing, if ever served from there) and every school subdomain
# (school1.managevidya.in, school2.managevidya.in, ...) in one entry, so
# no CORS change is needed when onboarding a new school.
# CORS_ALLOWED_ORIGINS="https://managevidya.in,https://*.managevidya.in"

# Set to "1" only once the app is deployed behind a reverse proxy (Caddy/
# nginx) that itself sets X-Forwarded-For from the real client IP -- see
# the TRUST_PROXY comment in src/main.ts. Leave unset for local dev and
# for any directly internet-facing deployment (setting it there lets a
# client spoof its IP and dodge rate limiting).
# TRUST_PROXY=1

# Set to "1" only for the E2E suite (wired automatically via
# apps/e2e/playwright.config.ts and .github/workflows/e2e.yml) -- it
# legitimately logs the same fixed persona emails in from one IP far more
# often per minute than any real user would. Never set this in production.
# THROTTLE_DISABLED=1

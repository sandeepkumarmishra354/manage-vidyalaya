# The schema-owning role, used only by migrations (node-pg-migrate) and the
# two deliberate tenant-less escape hatches (DbService.queryUnscoped for
# login-by-email, and scripts/seed.ts) -- see migrations/*_enable-row-level-
# security.sql and *_force-row-level-security.sql for why those need it and
# how they stay safe under FORCE ROW LEVEL SECURITY.
DATABASE_URL="postgresql://vidyalaya:vidyalaya@localhost:5432/vidyalaya?schema=public"
# What the running app actually connects as (DbService, see src/db/):
# the restricted `vidyalaya_app` role, which Row-Level Security enforces.
APP_DATABASE_URL="postgresql://vidyalaya_app:vidyalaya_app_dev_only_change_me@localhost:5432/vidyalaya?schema=public"
JWT_SECRET="dev-only-change-me"
JWT_ACCESS_TOKEN_TTL="1h"
JWT_REFRESH_TOKEN_TTL="30d"
PORT=3001
# Comma-separated list of allowed browser origins for CORS. Each entry is
# either an exact origin or a single-level subdomain wildcard, e.g.:
#   CORS_ALLOWED_ORIGINS="https://app.yourdomain.tld,https://*.yourdomain.tld"
# ("*.yourdomain.tld" matches "https://greenwood.yourdomain.tld" but not
# "https://foo.bar.yourdomain.tld"). Leave unset for local dev -- falls back
# to allowing every origin (see src/common/cors.ts). Must be set once real
# school subdomains are live browser origins hitting this API.
# CORS_ALLOWED_ORIGINS=

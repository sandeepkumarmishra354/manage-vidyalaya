# Prisma (still used by not-yet-converted modules) connects as the schema-owning
# `vidyalaya` role, which Postgres Row-Level Security never restricts by default.
DATABASE_URL="postgresql://vidyalaya:vidyalaya@localhost:5432/vidyalaya?schema=public"
# DbService (the raw-pg replacement, see src/db/) connects as the restricted
# `vidyalaya_app` role instead, which RLS does enforce -- see
# migrations/*_enable-row-level-security.sql. Once every module is off
# Prisma, this becomes the only connection string the app needs.
APP_DATABASE_URL="postgresql://vidyalaya_app:vidyalaya_app_dev_only_change_me@localhost:5432/vidyalaya?schema=public"
JWT_SECRET="dev-only-change-me"
JWT_ACCESS_TOKEN_TTL="1h"
JWT_REFRESH_TOKEN_TTL="30d"
PORT=3001

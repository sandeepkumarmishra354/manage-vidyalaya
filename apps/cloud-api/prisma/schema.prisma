// Prisma schema for the cloud-api Postgres database.
//
// cloud-api is the sole system of record (online-only REST architecture --
// see docs/architecture.md). Every domain entity from the original SQLite
// schema (packages/db-schema/migrations/) is modeled here relationally, with
// real Prisma `@relation`s for referential integrity and `include`-based
// joins instead of the old bare-FK-id-as-string approach.
//
// Conventions carried over from the original schema, applied to every model:
//   - money fields are integer paise (minor units), never floats
//   - `updatedAt`/`updatedBy`/`deletedAt` (soft delete)/`version` on every
//     mutable table
//   - `tenantId` and `branchId` are kept as plain scoping columns (no
//     Prisma relation) on domain tables -- they're multi-tenancy/branch
//     filters applied on every query via the auth guard, not a join target.
//     Tenant/Branch/Role/User/UserRole/RolePermission keep their existing
//     relations since those are genuinely queried that way for auth/RBAC.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// Tenancy, auth, RBAC
// ============================================================================

model Tenant {
  id                    String    @id
  name                  String
  subdomain             String?   @unique
  subscriptionStatus    String    @default("trial") @map("subscription_status")
  subscriptionExpiresAt DateTime? @map("subscription_expires_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  branches Branch[]
  users    User[]
  roles    Role[]

  @@map("tenants")
}

model Branch {
  id              String    @id
  tenantId        String    @map("tenant_id")
  name            String
  code            String
  address         String?
  city            String?
  state           String?
  pincode         String?
  phone           String?
  email           String?
  logoUrl         String?   @map("logo_url")
  signatureUrl    String?   @map("signature_url")
  printTemplate   String    @default("classic") @map("print_template")
  printPaperColor String    @default("white") @map("print_paper_color")
  isActive        Boolean   @default(true) @map("is_active")
  updatedAt       DateTime  @map("updated_at")
  updatedBy       String?   @map("updated_by")
  deletedAt       DateTime? @map("deleted_at")
  version         Int       @default(1)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, code])
  @@map("branches")
}

model Role {
  id        String    @id
  tenantId  String    @map("tenant_id")
  name      String
  isSystem  Boolean   @default(false) @map("is_system")
  updatedAt DateTime  @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1)

  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  userRoles   UserRole[]
  permissions RolePermission[]

  @@unique([tenantId, name])
  @@map("roles")
}

model RolePermission {
  id            String    @id
  tenantId      String    @map("tenant_id")
  roleId        String    @map("role_id")
  permissionKey String    @map("permission_key")
  updatedAt     DateTime  @map("updated_at")
  updatedBy     String?   @map("updated_by")
  deletedAt     DateTime? @map("deleted_at")
  version       Int       @default(1)

  role Role @relation(fields: [roleId], references: [id])

  @@unique([roleId, permissionKey])
  @@map("role_permissions")
}

model User {
  id           String    @id
  tenantId     String    @map("tenant_id")
  branchId     String?   @map("branch_id")
  fullName     String    @map("full_name")
  email        String
  phone        String?
  passwordHash String?   @map("password_hash")
  isActive     Boolean   @default(true) @map("is_active")
  updatedAt    DateTime  @map("updated_at")
  updatedBy    String?   @map("updated_by")
  deletedAt    DateTime? @map("deleted_at")
  version      Int       @default(1)

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  userRoles UserRole[]

  // Reverse relations from actor/owner foreign keys across domain modules.
  staffAccounts            Staff[]
  admissionsDecided        Admission[]
  attendanceRecordsMarked  AttendanceRecord[]
  feePaymentsRecorded      FeePayment[]
  housePointEventsAwarded  HousePointEvent[]
  libraryIssuesIssued      LibraryIssue[]
  payrollRunsGenerated     PayrollRun[]
  promotionBatchesExecuted PromotionBatch[]
  staffAttendanceMarked    StaffAttendance[]
  staffLeaveRequestsFiled  StaffLeaveRequest[] @relation("StaffLeaveRequestedBy")
  staffLeaveRequestsDecided StaffLeaveRequest[] @relation("StaffLeaveDecidedBy")
  auditLogsActor           AuditLog[]

  @@unique([tenantId, email])
  @@map("users")
}

model UserRole {
  id        String   @id
  tenantId  String   @map("tenant_id")
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  updatedAt DateTime @map("updated_at")
  version   Int      @default(1)

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
  @@map("user_roles")
}

// ============================================================================
// Academic structure
// ============================================================================

model AcademicSession {
  id        String    @id
  tenantId  String    @map("tenant_id")
  name      String
  startDate DateTime  @map("start_date")
  endDate   DateTime  @map("end_date")
  isCurrent Boolean   @default(false) @map("is_current")
  updatedAt DateTime  @map("updated_at")
  updatedBy String?   @map("updated_by")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1)

  classes              Class[]
  exams                Exam[]
  admissions           Admission[]
  teacherAssignments   TeacherSubjectAssignment[]
  housePointEvents     HousePointEvent[]
  studentEnrollments   StudentEnrollment[]
  feeStructures        FeeStructure[]
  feeInvoices          FeeInvoice[]
  electiveChoices      StudentElectiveChoice[]
  promotionBatchesFrom PromotionBatch[]           @relation("PromotionBatchFromSession")
  promotionBatchesTo   PromotionBatch[]           @relation("PromotionBatchToSession")
  schoolCalendars      SchoolCalendar[]

  @@map("academic_sessions")
}

// A branch's calendar for one academic session: which weekdays are always
// off/half-day (weeklyOffDays/weeklyHalfDays, 0=Sunday matching JS
// Date.getUTCDay()), plus dated CalendarHoliday overrides for specific
// public holidays. Drives attendance-grid greying and payroll's working-day
// calculation -- see SchoolCalendarService.getDayType.
model SchoolCalendar {
  id                String    @id
  tenantId          String    @map("tenant_id")
  branchId          String    @map("branch_id")
  academicSessionId String    @map("academic_session_id")
  weeklyOffDays     Int[]     @default([]) @map("weekly_off_days")
  weeklyHalfDays    Int[]     @default([]) @map("weekly_half_days")
  updatedAt         DateTime  @map("updated_at")
  updatedBy         String?   @map("updated_by")
  deletedAt         DateTime? @map("deleted_at")
  version           Int       @default(1)

  academicSession AcademicSession   @relation(fields: [academicSessionId], references: [id])
  holidays        CalendarHoliday[]

  @@unique([branchId, academicSessionId])
  @@map("school_calendars")
}

// A dated override -- a specific holiday or half-day -- that always wins
// over the weekly rule for that one date.
model CalendarHoliday {
  id               String    @id
  tenantId         String    @map("tenant_id")
  schoolCalendarId String    @map("school_calendar_id")
  date             DateTime
  name             String
  type             String // "holiday" | "half_day"
  updatedAt        DateTime  @map("updated_at")
  updatedBy        String?   @map("updated_by")
  deletedAt        DateTime? @map("deleted_at")
  version          Int       @default(1)

  schoolCalendar SchoolCalendar @relation(fields: [schoolCalendarId], references: [id])

  @@unique([schoolCalendarId, date])
  @@index([schoolCalendarId])
  @@map("calendar_holidays")
}

model Class {
  id                String    @id
  tenantId          String    @map("tenant_id")
  branchId          String    @map("branch_id")
  academicSessionId String    @map("academic_session_id")
  name              String
  sortOrder         Int       @default(0) @map("sort_order")
  updatedAt         DateTime  @map("updated_at")
  updatedBy         String?   @map("updated_by")
  deletedAt         DateTime? @map("deleted_at")
  version           Int       @default(1)

  academicSession AcademicSession @relation(fields: [academicSessionId], references: [id])

  sections           Section[]
  studentsCurrent    Student[]
  feeStructures      FeeStructure[]
  exams              Exam[]
  teacherAssignments TeacherSubjectAssignment[]
  admissionsApplied  Admission[]
  studentEnrollments StudentEnrollment[]
  attendanceRecords  AttendanceRecord[]
  promotionItemsFrom PromotionBatchItem[]       @relation("PromotionItemFromClass")
  promotionItemsTo   PromotionBatchItem[]       @relation("PromotionItemToClass")
  classSubjects      ClassSubject[]
  electiveGroups     SubjectElectiveGroup[]

  @@index([branchId, academicSessionId])
  @@map("classes")
}

model Section {
  id                  String    @id
  tenantId            String    @map("tenant_id")
  classId             String    @map("class_id")
  name                String
  classTeacherStaffId String?   @map("class_teacher_staff_id")
  capacity            Int?
  updatedAt           DateTime  @map("updated_at")
  updatedBy           String?   @map("updated_by")
  deletedAt           DateTime? @map("deleted_at")
  version             Int       @default(1)

  class             Class  @relation(fields: [classId], references: [id])
  classTeacherStaff Staff? @relation(fields: [classTeacherStaffId], references: [id])

  studentsCurrent    Student[]
  attendanceRecords  AttendanceRecord[]
  teacherAssignments TeacherSubjectAssignment[]
  studentEnrollments StudentEnrollment[]
  promotionItemsFrom PromotionBatchItem[]       @relation("PromotionItemFromSection")
  promotionItemsTo   PromotionBatchItem[]       @relation("PromotionItemToSection")

  @@index([classId])
  @@map("sections")
}

// ============================================================================
// Students, guardians, admissions
// ============================================================================

model Student {
  id                    String    @id
  tenantId              String    @map("tenant_id")
  branchId              String    @map("branch_id")
  admissionNumber       String?   @map("admission_number")
  rollNumber            String?   @map("roll_number")
  firstName             String    @map("first_name")
  lastName              String?   @map("last_name")
  dateOfBirth           DateTime? @map("date_of_birth")
  gender                String?
  bloodGroup            String?   @map("blood_group")
  photoPath             String?   @map("photo_path")
  currentClassId        String?   @map("current_class_id")
  currentSectionId      String?   @map("current_section_id")
  status                String    @default("enquiry")
  address               String?
  city                  String?
  state                 String?
  pincode               String?
  notes                 String?
  category              String?
  religion              String?
  nationality           String?
  motherTongue          String?   @map("mother_tongue")
  aadhaarNumber         String?   @map("aadhaar_number")
  previousSchoolName    String?   @map("previous_school_name")
  medicalNotes          String?   @map("medical_notes")
  emergencyContactName  String?   @map("emergency_contact_name")
  emergencyContactPhone String?   @map("emergency_contact_phone")
  updatedAt             DateTime  @map("updated_at")
  updatedBy             String?   @map("updated_by")
  deletedAt             DateTime? @map("deleted_at")
  version               Int       @default(1)

  currentClass   Class?   @relation(fields: [currentClassId], references: [id])
  currentSection Section? @relation(fields: [currentSectionId], references: [id])

  studentGuardians      StudentGuardian[]
  admissions            Admission[]
  attendanceRecords     AttendanceRecord[]
  feeInvoices           FeeInvoice[]
  studentFeeAssignments StudentFeeAssignment[]
  studentFeeDiscounts   StudentFeeDiscount[]
  examMarks             ExamMark[]
  studentHouse          StudentHouse?
  housePointEvents      HousePointEvent[]
  libraryIssues         LibraryIssue[]
  studentTransport      StudentTransport?
  studentEnrollments    StudentEnrollment[]
  promotionBatchItems   PromotionBatchItem[]
  electiveChoices       StudentElectiveChoice[]

  @@unique([tenantId, admissionNumber])
  @@index([tenantId, branchId])
  @@index([currentClassId, currentSectionId])
  @@map("students")
}

model Guardian {
  id            String    @id
  tenantId      String    @map("tenant_id")
  fullName      String    @map("full_name")
  relation      String?
  phone         String?
  altPhone      String?   @map("alt_phone")
  email         String?
  occupation    String?
  address       String?
  aadhaarNumber String?   @map("aadhaar_number")
  annualIncome  Int?      @map("annual_income") // rupees, NOT paise -- informational/eligibility field, not a transactional amount.
  updatedAt     DateTime  @map("updated_at")
  updatedBy     String?   @map("updated_by")
  deletedAt     DateTime? @map("deleted_at")
  version       Int       @default(1)

  studentGuardians StudentGuardian[]

  @@map("guardians")
}

model StudentGuardian {
  id               String   @id
  tenantId         String   @map("tenant_id")
  studentId        String   @map("student_id")
  guardianId       String   @map("guardian_id")
  relation         String
  isPrimaryContact Boolean  @default(false) @map("is_primary_contact")
  updatedAt        DateTime @map("updated_at")
  version          Int      @default(1)

  student  Student  @relation(fields: [studentId], references: [id])
  guardian Guardian @relation(fields: [guardianId], references: [id])

  @@unique([studentId, guardianId])
  @@index([studentId])
  @@map("student_guardians")
}

model Admission {
  id                String    @id
  tenantId          String    @map("tenant_id")
  branchId          String    @map("branch_id")
  studentId         String    @map("student_id")
  appliedClassId    String?   @map("applied_class_id")
  academicSessionId String    @map("academic_session_id")
  stage             String    @default("enquiry")
  appliedAt         DateTime  @map("applied_at")
  decidedAt         DateTime? @map("decided_at")
  decidedBy         String?   @map("decided_by")
  remarks           String?
  updatedAt         DateTime  @map("updated_at")
  updatedBy         String?   @map("updated_by")
  deletedAt         DateTime? @map("deleted_at")
  version           Int       @default(1)

  student         Student         @relation(fields: [studentId], references: [id])
  appliedClass    Class?          @relation(fields: [appliedClassId], references: [id])
  academicSession AcademicSession @relation(fields: [academicSessionId], references: [id])
  decidedByUser   User?           @relation(fields: [decidedBy], references: [id])

  @@index([branchId, stage])
  @@map("admissions")
}

// ============================================================================
// Attendance
// ============================================================================

model AttendanceRecord {
  id             String    @id
  tenantId       String    @map("tenant_id")
  branchId       String    @map("branch_id")
  studentId      String    @map("student_id")
  classId        String?   @map("class_id")
  sectionId      String?   @map("section_id")
  attendanceDate DateTime  @map("attendance_date")
  status         String
  markedBy       String?   @map("marked_by")
  remarks        String?
  updatedAt      DateTime  @map("updated_at")
  updatedBy      String?   @map("updated_by")
  deletedAt      DateTime? @map("deleted_at")
  version        Int       @default(1)

  student      Student  @relation(fields: [studentId], references: [id])
  class        Class?   @relation(fields: [classId], references: [id])
  section      Section? @relation(fields: [sectionId], references: [id])
  markedByUser User?    @relation(fields: [markedBy], references: [id])

  @@unique([tenantId, studentId, attendanceDate])
  @@index([branchId, attendanceDate])
  @@index([classId, sectionId, attendanceDate])
  @@map("attendance_records")
}

// ============================================================================
// Fees & billing
// ============================================================================

// A tenant-extensible fee category list. `key` is a stable slug matching
// FeeStructure.feeType's existing string values (e.g. "tuition") -- kept
// separate from `name` so renaming a category doesn't break existing
// FeeStructure rows that reference it by key.
model FeeCategory {
  id        String    @id
  tenantId  String    @map("tenant_id")
  name      String
  key       String
  isSystem  Boolean   @default(false) @map("is_system")
  updatedAt DateTime  @map("updated_at")
  updatedBy String?   @map("updated_by")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1)

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("fee_categories")
}

model FeeStructure {
  id                String    @id
  tenantId          String    @map("tenant_id")
  branchId          String    @map("branch_id")
  // Nullable: a "session-independent" structure (e.g. a flat library fee
  // that never changes) applies until explicitly changed, with no need to
  // recreate it every session. When null, classId must also be null -- a
  // class only exists within one session, so a class-scoped fee inherently
  // needs a session (enforced in the service layer).
  academicSessionId String?   @map("academic_session_id")
  classId           String?   @map("class_id")
  name              String
  amount            Int
  frequency         String    @default("one_time")
  feeType           String    @default("tuition") @map("fee_type")
  updatedAt         DateTime  @map("updated_at")
  updatedBy         String?   @map("updated_by")
  deletedAt         DateTime? @map("deleted_at")
  version           Int       @default(1)

  academicSession       AcademicSession?       @relation(fields: [academicSessionId], references: [id])
  class                 Class?                 @relation(fields: [classId], references: [id])
  feeInvoices           FeeInvoice[]
  studentFeeAssignments StudentFeeAssignment[]

  @@index([branchId, academicSessionId])
  @@map("fee_structures")
}

// Per-student opt-out of a class/branch-wide fee structure ("exclude"), or
// a one-off assignment of a structure to a student it wouldn't normally
// match ("include"). generateInvoices' eligible-student set is derived as
// (class/branch-wide enrolled students UNION "include" rows) MINUS
// "exclude" rows.
model StudentFeeAssignment {
  id             String    @id
  tenantId       String    @map("tenant_id")
  branchId       String    @map("branch_id")
  studentId      String    @map("student_id")
  feeStructureId String    @map("fee_structure_id")
  mode           String
  reason         String?
  updatedAt      DateTime  @map("updated_at")
  updatedBy      String?   @map("updated_by")
  deletedAt      DateTime? @map("deleted_at")
  version        Int       @default(1)

  student      Student      @relation(fields: [studentId], references: [id])
  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id])

  @@unique([studentId, feeStructureId])
  @@map("student_fee_assignments")
}

model FeeInvoice {
  id                String    @id
  tenantId          String    @map("tenant_id")
  branchId          String    @map("branch_id")
  studentId         String    @map("student_id")
  feeStructureId    String    @map("fee_structure_id")
  academicSessionId String    @map("academic_session_id")
  // "" for one_time/annual structures; a period label ("Apr 2026", "Q1
  // 2026-27") for monthly/quarterly, one invoice per period.
  periodLabel       String    @default("") @map("period_label")
  grossAmount       Int       @default(0) @map("gross_amount")
  discountAmount    Int       @default(0) @map("discount_amount")
  amountDue         Int       @map("amount_due")
  amountPaid        Int       @default(0) @map("amount_paid")
  dueDate           DateTime? @map("due_date")
  status            String    @default("pending")
  updatedAt         DateTime  @map("updated_at")
  updatedBy         String?   @map("updated_by")
  deletedAt         DateTime? @map("deleted_at")
  version           Int       @default(1)

  student             Student              @relation(fields: [studentId], references: [id])
  feeStructure        FeeStructure         @relation(fields: [feeStructureId], references: [id])
  academicSession     AcademicSession      @relation(fields: [academicSessionId], references: [id])
  feePayments         FeePayment[]
  feeInvoiceDiscounts FeeInvoiceDiscount[]

  @@unique([feeStructureId, studentId, periodLabel])
  @@index([studentId])
  @@index([branchId, status])
  @@map("fee_invoices")
}

model FeePayment {
  id            String    @id
  tenantId      String    @map("tenant_id")
  invoiceId     String    @map("invoice_id")
  amount        Int
  paymentMethod String    @default("cash") @map("payment_method")
  paymentDate   DateTime  @map("payment_date")
  receiptNumber String?   @map("receipt_number")
  recordedBy    String?   @map("recorded_by")
  remarks       String?
  updatedAt     DateTime  @map("updated_at")
  updatedBy     String?   @map("updated_by")
  deletedAt     DateTime? @map("deleted_at")
  version       Int       @default(1)

  invoice        FeeInvoice @relation(fields: [invoiceId], references: [id])
  recordedByUser User?      @relation(fields: [recordedBy], references: [id])

  @@index([invoiceId])
  @@index([tenantId, receiptNumber])
  @@map("fee_payments")
}

// A tenant-extensible discount/waiver definition (e.g. "Sibling discount",
// "Staff ward concession"). Optionally scoped to one FeeCategory and/or a
// validity window.
model FeeDiscount {
  id            String    @id
  tenantId      String    @map("tenant_id")
  name          String
  key           String
  discountType  String    @map("discount_type")
  value         Int
  feeCategoryId String?   @map("fee_category_id")
  isActive      Boolean   @default(true) @map("is_active")
  validFrom     DateTime? @map("valid_from")
  validTo       DateTime? @map("valid_to")
  updatedAt     DateTime  @map("updated_at")
  updatedBy     String?   @map("updated_by")
  deletedAt     DateTime? @map("deleted_at")
  version       Int       @default(1)

  studentFeeDiscounts StudentFeeDiscount[]
  feeInvoiceDiscounts FeeInvoiceDiscount[]

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("fee_discounts")
}

// A discount assigned to a specific student -- applied automatically to
// every future invoice generated for them (see generateInvoices).
model StudentFeeDiscount {
  id            String    @id
  tenantId      String    @map("tenant_id")
  studentId     String    @map("student_id")
  feeDiscountId String    @map("fee_discount_id")
  reason        String?
  updatedAt     DateTime  @map("updated_at")
  updatedBy     String?   @map("updated_by")
  deletedAt     DateTime? @map("deleted_at")
  version       Int       @default(1)

  student     Student     @relation(fields: [studentId], references: [id])
  feeDiscount FeeDiscount @relation(fields: [feeDiscountId], references: [id])

  @@unique([studentId, feeDiscountId])
  @@map("student_fee_discounts")
}

// Audit trail of which discounts hit which invoice, and for how much --
// amountDue on FeeInvoice stays the single source of truth
// (grossAmount - discountAmount); this table just explains how
// discountAmount was composed.
model FeeInvoiceDiscount {
  id            String   @id
  tenantId      String   @map("tenant_id")
  feeInvoiceId  String   @map("fee_invoice_id")
  feeDiscountId String   @map("fee_discount_id")
  amount        Int
  createdAt     DateTime @map("created_at")

  feeInvoice  FeeInvoice  @relation(fields: [feeInvoiceId], references: [id])
  feeDiscount FeeDiscount @relation(fields: [feeDiscountId], references: [id])

  @@index([feeInvoiceId])
  @@map("fee_invoice_discounts")
}

// ============================================================================
// Exams & report cards
// ============================================================================

model Subject {
  id        String    @id
  tenantId  String    @map("tenant_id")
  branchId  String    @map("branch_id")
  name      String
  code      String?
  updatedAt DateTime  @map("updated_at")
  updatedBy String?   @map("updated_by")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1)

  examMarks          ExamMark[]
  teacherAssignments TeacherSubjectAssignment[]
  classSubjects      ClassSubject[]
  electiveChoices    StudentElectiveChoice[]

  @@index([branchId])
  @@map("subjects")
}

// Which subjects apply to a class (mandatory vs. elective). Elective
// membership within a choice group is modeled by SubjectElectiveGroupMember,
// referencing this row rather than Subject directly, so a subject's
// elective-ness and its class scoping stay in one place.
model ClassSubject {
  id         String    @id
  tenantId   String    @map("tenant_id")
  branchId   String    @map("branch_id")
  classId    String    @map("class_id")
  subjectId  String    @map("subject_id")
  isElective Boolean   @default(false) @map("is_elective")
  updatedAt  DateTime  @map("updated_at")
  updatedBy  String?   @map("updated_by")
  deletedAt  DateTime? @map("deleted_at")
  version    Int       @default(1)

  class   Class   @relation(fields: [classId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])

  electiveGroupMemberships SubjectElectiveGroupMember[]

  @@unique([classId, subjectId])
  @@index([classId])
  @@map("class_subjects")
}

// A named choice group for a class (e.g. "Elective 1": Art vs Computer) --
// a student picks exactly one member subject per group per academic session.
model SubjectElectiveGroup {
  id        String    @id
  tenantId  String    @map("tenant_id")
  branchId  String    @map("branch_id")
  classId   String    @map("class_id")
  name      String
  updatedAt DateTime  @map("updated_at")
  updatedBy String?   @map("updated_by")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1)

  class Class @relation(fields: [classId], references: [id])

  members SubjectElectiveGroupMember[]
  choices StudentElectiveChoice[]

  @@unique([classId, name])
  @@index([classId])
  @@map("subject_elective_groups")
}

model SubjectElectiveGroupMember {
  id              String    @id
  tenantId        String    @map("tenant_id")
  electiveGroupId String    @map("elective_group_id")
  classSubjectId  String    @map("class_subject_id")
  updatedAt       DateTime  @map("updated_at")
  updatedBy       String?   @map("updated_by")
  deletedAt       DateTime? @map("deleted_at")
  version         Int       @default(1)

  electiveGroup SubjectElectiveGroup @relation(fields: [electiveGroupId], references: [id])
  classSubject  ClassSubject         @relation(fields: [classSubjectId], references: [id])

  @@unique([electiveGroupId, classSubjectId])
  @@index([electiveGroupId])
  @@map("subject_elective_group_members")
}

// A student's pick for one elective group, per academic session -- one row
// per group per session, so re-electing next session is a new row and
// history is preserved rather than overwritten.
model StudentElectiveChoice {
  id                String    @id
  tenantId          String    @map("tenant_id")
  studentId         String    @map("student_id")
  electiveGroupId   String    @map("elective_group_id")
  subjectId         String    @map("subject_id")
  academicSessionId String    @map("academic_session_id")
  updatedAt         DateTime  @map("updated_at")
  updatedBy         String?   @map("updated_by")
  deletedAt         DateTime? @map("deleted_at")
  version           Int       @default(1)

  student         Student              @relation(fields: [studentId], references: [id])
  electiveGroup   SubjectElectiveGroup @relation(fields: [electiveGroupId], references: [id])
  subject         Subject              @relation(fields: [subjectId], references: [id])
  academicSession AcademicSession      @relation(fields: [academicSessionId], references: [id])

  @@unique([studentId, electiveGroupId, academicSessionId])
  @@index([studentId])
  @@map("student_elective_choices")
}

model Exam {
  id                 String    @id
  tenantId           String    @map("tenant_id")
  branchId           String    @map("branch_id")
  academicSessionId  String    @map("academic_session_id")
  classId            String    @map("class_id")
  name               String
  examDate           DateTime? @map("exam_date")
  examType           String    @default("regular") @map("exam_type")
  parentExamId       String?   @map("parent_exam_id")
  passingPercentage  Float     @default(33.0) @map("passing_percentage")
  resultsPublishedAt DateTime? @map("results_published_at")
  updatedAt          DateTime  @map("updated_at")
  updatedBy          String?   @map("updated_by")
  deletedAt          DateTime? @map("deleted_at")
  version            Int       @default(1)

  academicSession AcademicSession @relation(fields: [academicSessionId], references: [id])
  class           Class           @relation(fields: [classId], references: [id])
  parentExam      Exam?           @relation("ExamBackPaper", fields: [parentExamId], references: [id])
  backPapers      Exam[]          @relation("ExamBackPaper")
  examMarks       ExamMark[]

  @@index([branchId, classId, academicSessionId])
  @@map("exams")
}

model ExamMark {
  id            String    @id
  tenantId      String    @map("tenant_id")
  examId        String    @map("exam_id")
  subjectId     String    @map("subject_id")
  studentId     String    @map("student_id")
  maxMarks      Int       @default(100) @map("max_marks")
  marksObtained Float?    @map("marks_obtained")
  isAbsent      Boolean   @default(false) @map("is_absent")
  result        String? // "pass" | "fail" | "grace" -- null until marks are entered; auto-computed on save unless explicitly overridden
  remarks       String?
  updatedAt     DateTime  @map("updated_at")
  updatedBy     String?   @map("updated_by")
  deletedAt     DateTime? @map("deleted_at")
  version       Int       @default(1)

  exam    Exam    @relation(fields: [examId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])
  student Student @relation(fields: [studentId], references: [id])

  @@unique([examId, subjectId, studentId])
  @@index([examId])
  @@index([studentId])
  @@map("exam_marks")
}

// ============================================================================
// Module settings (per-branch feature toggles)
// ============================================================================

model ModuleSetting {
  id        String    @id
  tenantId  String    @map("tenant_id")
  branchId  String    @map("branch_id")
  moduleKey String    @map("module_key")
  isEnabled Boolean   @default(true) @map("is_enabled")
  updatedAt DateTime  @map("updated_at")
  updatedBy String?   @map("updated_by")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1)

  @@unique([branchId, moduleKey])
  @@index([branchId])
  @@map("module_settings")
}

// ============================================================================
// Houses
// ============================================================================

model House {
  id        String    @id
  tenantId  String    @map("tenant_id")
  branchId  String    @map("branch_id")
  name      String
  color     String?
  updatedAt DateTime  @map("updated_at")
  updatedBy String?   @map("updated_by")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1)

  studentHouses    StudentHouse[]
  housePointEvents HousePointEvent[]

  @@unique([branchId, name])
  @@index([branchId])
  @@map("houses")
}

model StudentHouse {
  id        String    @id
  tenantId  String    @map("tenant_id")
  studentId String    @unique @map("student_id")
  houseId   String    @map("house_id")
  updatedAt DateTime  @map("updated_at")
  updatedBy String?   @map("updated_by")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1)

  student Student @relation(fields: [studentId], references: [id])
  house   House   @relation(fields: [houseId], references: [id])

  @@index([houseId])
  @@map("student_houses")
}

model HousePointEvent {
  id                String    @id
  tenantId          String    @map("tenant_id")
  branchId          String    @map("branch_id")
  houseId           String    @map("house_id")
  studentId         String?   @map("student_id")
  academicSessionId String?   @map("academic_session_id")
  points            Int
  reason            String
  eventDate         DateTime  @map("event_date")
  awardedBy         String?   @map("awarded_by")
  updatedAt         DateTime  @map("updated_at")
  updatedBy         String?   @map("updated_by")
  deletedAt         DateTime? @map("deleted_at")
  version           Int       @default(1)

  house           House            @relation(fields: [houseId], references: [id])
  student         Student?         @relation(fields: [studentId], references: [id])
  academicSession AcademicSession? @relation(fields: [academicSessionId], references: [id])
  awardedByUser   User?            @relation(fields: [awardedBy], references: [id])

  @@index([houseId])
  @@index([academicSessionId])
  @@map("house_point_events")
}

// ============================================================================
// Library
// ============================================================================

model LibraryBook {
  id              String    @id
  tenantId        String    @map("tenant_id")
  branchId        String    @map("branch_id")
  title           String
  author          String?
  isbn            String?
  category        String?
  totalCopies     Int       @default(1) @map("total_copies")
  availableCopies Int       @default(1) @map("available_copies")
  updatedAt       DateTime  @map("updated_at")
  updatedBy       String?   @map("updated_by")
  deletedAt       DateTime? @map("deleted_at")
  version         Int       @default(1)

  libraryIssues LibraryIssue[]

  @@index([branchId])
  @@map("library_books")
}

model LibraryIssue {
  id           String    @id
  tenantId     String    @map("tenant_id")
  branchId     String    @map("branch_id")
  bookId       String    @map("book_id")
  studentId    String    @map("student_id")
  issuedDate   DateTime  @map("issued_date")
  dueDate      DateTime  @map("due_date")
  returnedDate DateTime? @map("returned_date")
  status       String    @default("issued")
  issuedBy     String?   @map("issued_by")
  updatedAt    DateTime  @map("updated_at")
  updatedBy    String?   @map("updated_by")
  deletedAt    DateTime? @map("deleted_at")
  version      Int       @default(1)

  book         LibraryBook @relation(fields: [bookId], references: [id])
  student      Student     @relation(fields: [studentId], references: [id])
  issuedByUser User?       @relation(fields: [issuedBy], references: [id])

  @@index([bookId])
  @@index([studentId])
  @@index([branchId, status])
  @@map("library_issues")
}

// ============================================================================
// Transport
// ============================================================================

model TransportRoute {
  id            String    @id
  tenantId      String    @map("tenant_id")
  branchId      String    @map("branch_id")
  name          String
  vehicleNumber String?   @map("vehicle_number")
  driverName    String?   @map("driver_name")
  driverPhone   String?   @map("driver_phone")
  capacity      Int?
  updatedAt     DateTime  @map("updated_at")
  updatedBy     String?   @map("updated_by")
  deletedAt     DateTime? @map("deleted_at")
  version       Int       @default(1)

  stops             TransportStop[]
  studentTransports StudentTransport[]

  @@index([branchId])
  @@map("transport_routes")
}

model TransportStop {
  id         String    @id
  tenantId   String    @map("tenant_id")
  routeId    String    @map("route_id")
  name       String
  sequence   Int       @default(0)
  pickupTime String?   @map("pickup_time")
  updatedAt  DateTime  @map("updated_at")
  updatedBy  String?   @map("updated_by")
  deletedAt  DateTime? @map("deleted_at")
  version    Int       @default(1)

  route             TransportRoute     @relation(fields: [routeId], references: [id])
  studentTransports StudentTransport[]

  @@index([routeId])
  @@map("transport_stops")
}

model StudentTransport {
  id        String    @id
  tenantId  String    @map("tenant_id")
  studentId String    @unique @map("student_id")
  routeId   String    @map("route_id")
  stopId    String    @map("stop_id")
  updatedAt DateTime  @map("updated_at")
  updatedBy String?   @map("updated_by")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1)

  student Student        @relation(fields: [studentId], references: [id])
  route   TransportRoute @relation(fields: [routeId], references: [id])
  stop    TransportStop  @relation(fields: [stopId], references: [id])

  @@index([routeId])
  @@map("student_transport")
}

// ============================================================================
// Staff / HR
// ============================================================================

// A tenant-extensible broad classification (Teacher, Accountant, Librarian,
// Peon, ...) -- additive alongside Staff.designation, which stays free-text
// for something more specific ("PGT Mathematics").
model StaffCategory {
  id        String    @id
  tenantId  String    @map("tenant_id")
  name      String
  isSystem  Boolean   @default(false) @map("is_system")
  updatedAt DateTime  @map("updated_at")
  updatedBy String?   @map("updated_by")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1)

  staff Staff[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("staff_categories")
}

// Generic tenant-customizable lookup lists (student category, religion,
// nationality, mother tongue, blood group, gender, guardian relation) --
// one table with a `type` discriminator instead of one near-identical
// table per list, since these are all just "a name a school can add/rename/
// remove". Student/Staff/Guardian columns that reference these values
// (e.g. Student.religion) stay plain strings populated by `name`, not by
// this table's id -- see MasterDataItem admin module for details.
model MasterDataItem {
  id        String    @id
  tenantId  String    @map("tenant_id")
  type      String
  name      String
  isSystem  Boolean   @default(false) @map("is_system")
  sortOrder Int       @default(0) @map("sort_order")
  updatedAt DateTime  @map("updated_at")
  updatedBy String?   @map("updated_by")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1)

  @@unique([tenantId, type, name])
  @@index([tenantId, type])
  @@map("master_data_items")
}

model Staff {
  id                    String    @id
  tenantId              String    @map("tenant_id")
  branchId              String    @map("branch_id")
  userId                String?   @map("user_id")
  employeeCode          String    @map("employee_code")
  firstName             String    @map("first_name")
  lastName              String?   @map("last_name")
  dateOfBirth           DateTime? @map("date_of_birth")
  gender                String?
  phone                 String?
  personalEmail         String?   @map("personal_email")
  address               String?
  city                  String?
  state                 String?
  pincode               String?
  designation           String
  department            String?
  categoryId            String?   @map("category_id")
  employmentType        String    @default("full_time") @map("employment_type")
  dateOfJoining         DateTime  @map("date_of_joining")
  dateOfLeaving         DateTime? @map("date_of_leaving")
  status                String    @default("active")
  qualification         String?
  bloodGroup            String?   @map("blood_group")
  photoPath             String?   @map("photo_path")
  signatureUrl          String?   @map("signature_url")
  isPrincipal           Boolean   @default(false) @map("is_principal")
  panNumber             String?   @map("pan_number")
  aadhaarNumber         String?   @map("aadhaar_number")
  bankAccountNumber     String?   @map("bank_account_number")
  bankIfsc              String?   @map("bank_ifsc")
  bankName              String?   @map("bank_name")
  pfNumber              String?   @map("pf_number")
  esiNumber             String?   @map("esi_number")
  uanNumber             String?   @map("uan_number")
  emergencyContactName  String?   @map("emergency_contact_name")
  emergencyContactPhone String?   @map("emergency_contact_phone")
  notes                 String?
  updatedAt             DateTime  @map("updated_at")
  updatedBy             String?   @map("updated_by")
  deletedAt             DateTime? @map("deleted_at")
  version               Int       @default(1)

  user     User?          @relation(fields: [userId], references: [id])
  category StaffCategory? @relation(fields: [categoryId], references: [id])

  sectionsAsClassTeacher Section[]
  teacherAssignments     TeacherSubjectAssignment[]
  staffAttendance        StaffAttendance[]
  leaveRequests          StaffLeaveRequest[]
  salaryStructures       SalaryStructure[]
  payslips               Payslip[]

  @@unique([tenantId, employeeCode])
  @@index([branchId])
  @@index([userId])
  @@index([categoryId])
  @@map("staff")
}

model TeacherSubjectAssignment {
  id                String    @id
  tenantId          String    @map("tenant_id")
  branchId          String    @map("branch_id")
  staffId           String    @map("staff_id")
  classId           String    @map("class_id")
  sectionId         String?   @map("section_id")
  subjectId         String    @map("subject_id")
  academicSessionId String    @map("academic_session_id")
  updatedAt         DateTime  @map("updated_at")
  updatedBy         String?   @map("updated_by")
  deletedAt         DateTime? @map("deleted_at")
  version           Int       @default(1)

  staff           Staff           @relation(fields: [staffId], references: [id])
  class           Class           @relation(fields: [classId], references: [id])
  section         Section?        @relation(fields: [sectionId], references: [id])
  subject         Subject         @relation(fields: [subjectId], references: [id])
  academicSession AcademicSession @relation(fields: [academicSessionId], references: [id])

  @@unique([staffId, classId, sectionId, subjectId, academicSessionId])
  @@index([staffId])
  @@index([classId, sectionId])
  @@map("teacher_subject_assignments")
}

model StaffAttendance {
  id             String    @id
  tenantId       String    @map("tenant_id")
  branchId       String    @map("branch_id")
  staffId        String    @map("staff_id")
  attendanceDate DateTime  @map("attendance_date")
  status         String
  checkInTime    String?   @map("check_in_time")
  checkOutTime   String?   @map("check_out_time")
  markedBy       String?   @map("marked_by")
  remarks        String?
  updatedAt      DateTime  @map("updated_at")
  updatedBy      String?   @map("updated_by")
  deletedAt      DateTime? @map("deleted_at")
  version        Int       @default(1)

  staff        Staff @relation(fields: [staffId], references: [id])
  markedByUser User? @relation(fields: [markedBy], references: [id])

  @@unique([tenantId, staffId, attendanceDate])
  @@index([staffId, attendanceDate])
  @@index([branchId, attendanceDate])
  @@map("staff_attendance")
}

// Self-service staff leave requests: a staff member applies for their own
// leave (status starts "pending"), or HR/admin files one directly on a
// staff member's behalf (status starts "approved" since the filer already
// holds approval authority). Approval writes StaffAttendance rows with
// status "leave" for every date in the range -- payroll's LOP calculation
// already treats "leave" as a fully paid, non-deducted day, so no payroll
// changes are needed.
model StaffLeaveRequest {
  id                String    @id
  tenantId          String    @map("tenant_id")
  branchId          String    @map("branch_id")
  staffId           String    @map("staff_id")
  startDate         DateTime  @map("start_date")
  endDate           DateTime  @map("end_date")
  reason            String?
  status            String    @default("pending")
  requestedByUserId String    @map("requested_by_user_id")
  decidedByUserId   String?   @map("decided_by_user_id")
  decidedAt         DateTime? @map("decided_at")
  decisionNote      String?   @map("decision_note")
  createdAt         DateTime  @map("created_at")
  updatedAt         DateTime  @map("updated_at")
  updatedBy         String?   @map("updated_by")
  deletedAt         DateTime? @map("deleted_at")
  version           Int       @default(1)

  staff       Staff @relation(fields: [staffId], references: [id])
  requestedBy User  @relation("StaffLeaveRequestedBy", fields: [requestedByUserId], references: [id])
  decidedBy   User? @relation("StaffLeaveDecidedBy", fields: [decidedByUserId], references: [id])

  @@index([staffId, status])
  @@index([branchId, status])
  @@map("staff_leave_requests")
}

// ============================================================================
// Payroll
// ============================================================================

model SalaryStructure {
  id            String    @id
  tenantId      String    @map("tenant_id")
  branchId      String    @map("branch_id")
  staffId       String    @map("staff_id")
  effectiveFrom DateTime  @map("effective_from")
  basicAmount   Int       @map("basic_amount")
  updatedAt     DateTime  @map("updated_at")
  updatedBy     String?   @map("updated_by")
  deletedAt     DateTime? @map("deleted_at")
  version       Int       @default(1)

  staff            Staff             @relation(fields: [staffId], references: [id])
  salaryComponents SalaryComponent[]

  @@index([staffId, effectiveFrom])
  @@map("salary_structures")
}

model SalaryComponent {
  id                String    @id
  tenantId          String    @map("tenant_id")
  salaryStructureId String    @map("salary_structure_id")
  componentName     String    @map("component_name")
  componentType     String    @map("component_type")
  calculationType   String    @map("calculation_type")
  amount            Int?
  percent           Float?
  updatedAt         DateTime  @map("updated_at")
  updatedBy         String?   @map("updated_by")
  deletedAt         DateTime? @map("deleted_at")
  version           Int       @default(1)

  salaryStructure SalaryStructure @relation(fields: [salaryStructureId], references: [id])

  @@index([salaryStructureId])
  @@map("salary_components")
}

model PayrollRun {
  id          String    @id
  tenantId    String    @map("tenant_id")
  branchId    String    @map("branch_id")
  periodMonth Int       @map("period_month")
  periodYear  Int       @map("period_year")
  status      String    @default("draft")
  generatedAt DateTime  @map("generated_at")
  generatedBy String?   @map("generated_by")
  updatedAt   DateTime  @map("updated_at")
  updatedBy   String?   @map("updated_by")
  deletedAt   DateTime? @map("deleted_at")
  version     Int       @default(1)

  generatedByUser User?     @relation(fields: [generatedBy], references: [id])
  payslips        Payslip[]

  @@unique([branchId, periodMonth, periodYear])
  @@index([branchId, periodYear, periodMonth])
  @@map("payroll_runs")
}

model Payslip {
  id              String    @id
  tenantId        String    @map("tenant_id")
  payrollRunId    String    @map("payroll_run_id")
  staffId         String    @map("staff_id")
  daysInMonth     Float     @map("days_in_month")
  daysPresent     Float     @map("days_present")
  daysLop         Float     @default(0) @map("days_lop")
  grossEarnings   Int       @map("gross_earnings")
  totalDeductions Int       @map("total_deductions")
  netPay          Int       @map("net_pay")
  status          String    @default("draft")
  paidOn          DateTime? @map("paid_on")
  remarks         String?
  updatedAt       DateTime  @map("updated_at")
  updatedBy       String?   @map("updated_by")
  deletedAt       DateTime? @map("deleted_at")
  version         Int       @default(1)

  payrollRun PayrollRun        @relation(fields: [payrollRunId], references: [id])
  staff      Staff             @relation(fields: [staffId], references: [id])
  lineItems  PayslipLineItem[]

  @@unique([payrollRunId, staffId])
  @@index([payrollRunId])
  @@index([staffId])
  @@map("payslips")
}

model PayslipLineItem {
  id            String    @id
  tenantId      String    @map("tenant_id")
  payslipId     String    @map("payslip_id")
  componentName String    @map("component_name")
  componentType String    @map("component_type")
  amount        Int
  updatedAt     DateTime  @map("updated_at")
  updatedBy     String?   @map("updated_by")
  deletedAt     DateTime? @map("deleted_at")
  version       Int       @default(1)

  payslip Payslip @relation(fields: [payslipId], references: [id])

  @@index([payslipId])
  @@map("payslip_line_items")
}

// ============================================================================
// Promotion (session rollover)
// ============================================================================

model StudentEnrollment {
  id                String    @id
  tenantId          String    @map("tenant_id")
  branchId          String    @map("branch_id")
  studentId         String    @map("student_id")
  academicSessionId String    @map("academic_session_id")
  classId           String    @map("class_id")
  sectionId         String?   @map("section_id")
  rollNumber        String?   @map("roll_number")
  status            String    @default("promoted")
  updatedAt         DateTime  @map("updated_at")
  updatedBy         String?   @map("updated_by")
  deletedAt         DateTime? @map("deleted_at")
  version           Int       @default(1)

  student         Student         @relation(fields: [studentId], references: [id])
  academicSession AcademicSession @relation(fields: [academicSessionId], references: [id])
  class           Class           @relation(fields: [classId], references: [id])
  section         Section?        @relation(fields: [sectionId], references: [id])

  @@unique([studentId, academicSessionId])
  @@index([academicSessionId])
  @@map("student_enrollments")
}

model PromotionBatch {
  id               String    @id
  tenantId         String    @map("tenant_id")
  branchId         String    @map("branch_id")
  fromSessionId    String    @map("from_session_id")
  toSessionId      String    @map("to_session_id")
  classMappingJson Json      @map("class_mapping_json")
  status           String    @default("draft")
  executedAt       DateTime? @map("executed_at")
  executedBy       String?   @map("executed_by")
  createdAt        DateTime  @map("created_at")

  fromSession    AcademicSession      @relation("PromotionBatchFromSession", fields: [fromSessionId], references: [id])
  toSession      AcademicSession      @relation("PromotionBatchToSession", fields: [toSessionId], references: [id])
  executedByUser User?                @relation(fields: [executedBy], references: [id])
  items          PromotionBatchItem[]

  @@index([branchId])
  @@map("promotion_batches")
}

model PromotionBatchItem {
  id               String  @id
  tenantId         String  @map("tenant_id")
  promotionBatchId String  @map("promotion_batch_id")
  studentId        String  @map("student_id")
  fromClassId      String? @map("from_class_id")
  fromSectionId    String? @map("from_section_id")
  toClassId        String? @map("to_class_id")
  toSectionId      String? @map("to_section_id")
  decision         String  @default("promote")
  remarks          String?

  batch       PromotionBatch @relation(fields: [promotionBatchId], references: [id])
  student     Student        @relation(fields: [studentId], references: [id])
  fromClass   Class?         @relation("PromotionItemFromClass", fields: [fromClassId], references: [id])
  toClass     Class?         @relation("PromotionItemToClass", fields: [toClassId], references: [id])
  fromSection Section?       @relation("PromotionItemFromSection", fields: [fromSectionId], references: [id])
  toSection   Section?       @relation("PromotionItemToSection", fields: [toSectionId], references: [id])

  @@unique([promotionBatchId, studentId])
  @@index([promotionBatchId])
  @@map("promotion_batch_items")
}

// ============================================================================
// Audit log
// ============================================================================

model AuditLog {
  id          String   @id
  tenantId    String   @map("tenant_id")
  branchId    String?  @map("branch_id")
  actorUserId String?  @map("actor_user_id")
  entityTable String   @map("entity_table")
  entityId    String   @map("entity_id")
  action      String
  summary     String
  beforeJson  Json?    @map("before_json")
  afterJson   Json?    @map("after_json")
  createdAt   DateTime @map("created_at")

  actor User? @relation(fields: [actorUserId], references: [id])

  @@index([tenantId, createdAt])
  @@index([entityTable, entityId])
  @@map("audit_log")
}

# Same physical Postgres database as apps/cloud-api -- this app connects
# with the schema-owning role (RLS never applies to a table's owner),
# since a cross-tenant admin surface can't be served by cloud-api's
# per-request RLS session variable. Use the exact same DATABASE_URL value
# cloud-api's .env uses for its own DATABASE_URL (the schema-owning role,
# not APP_DATABASE_URL).
DATABASE_URL="postgresql://vidyalaya:vidyalaya@localhost:5432/vidyalaya?schema=public"

# Deliberately separate from cloud-api's JWT_SECRET -- a vendor operator
# token must never be accepted by cloud-api's tenant-scoped endpoints, or
# vice versa.
VENDOR_JWT_SECRET="dev-only-change-me-vendor"
VENDOR_JWT_TOKEN_TTL="12h"

PORT=3002

# Comma-separated list of exact origins or single-level subdomain
# wildcards allowed to call this API (e.g. the vendor-admin-web deploy
# origin). Unset allows every origin -- fine for local dev, must be set
# in production.
VENDOR_CORS_ALLOWED_ORIGINS=
